{
  "name": "lifeos-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "sqljs": "node -e \"for (const f of ['sql-wasm.js','sql-wasm.wasm']) require('fs').copyFileSync('node_modules/sql.js/dist/'+f, 'public/'+f)\"",
    "predev": "npm run sqljs",
    "prebuild": "npm run sqljs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.2.5",
    "@fontsource/nunito": "^5.2.5",
    "canvas-confetti": "^1.9.3",
    "framer-motion": "^12.9.2",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "sql.js": "^1.14.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  }
}
